apiVersion: v1
kind: Secret
metadata:
  name: user-secret
type: Opaque
stringData:
  POSTGRES_DB: "user_db"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "postgres"
  POSTGRES_URL: "jdbc:postgresql://user-db:5432/user_db"

  JWT_PRIVATE_KEY_PATH: "/app/config/jwt/private.pem"
  JWT_PUBLIC_KEY_PATH: "/app/config/jwt/public.pem"

  private.pem: |
    -----BEGIN PRIVATE KEY-----
    <private key>
    -----END PRIVATE KEY-----

  public.pem: |
    -----BEGIN PUBLIC KEY-----
    <public key>
    -----END PUBLIC KEY-----